# Set at least one. If several are set, PARSER_PROVIDER picks; otherwise the
# first configured one wins.

# Direct to the vendor
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=xai-...

# One key, many vendors — enables or/gemini, or/claude, or/grok, or/gpt
OPENROUTER_API_KEY=sk-or-...

# claude | grok | or/gemini | or/claude | or/grok | or/gpt
PARSER_PROVIDER=or/gemini

# Model overrides. Defaults come from openrouter.ai/api/v1/models and are
# filtered to models advertising structured outputs — change them if the
# catalogue moves or you want a different one.
# ANTHROPIC_MODEL=claude-opus-5
# XAI_MODEL=grok-4
# OPENROUTER_MODEL_GEMINI=google/gemini-3.8-flash
# OPENROUTER_MODEL_CLAUDE=anthropic/claude-opus-5
# OPENROUTER_MODEL_GROK=x-ai/grok-4.7
# OPENROUTER_MODEL_GPT=openai/gpt-6-astra

# Claude direct only: low | medium | high | xhigh | max  (default: low)
PARSE_EFFORT=low
